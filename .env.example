# For Docker Compose: a real domain pointing to your server, without https://
ERP_DOMAIN=school.example.com
# Generate a private random key of at least 32 characters; required on first production setup.
ERP_SETUP_TOKEN=

# Local development uses node server.js and does not read .env automatically.
# Set ERP_DEMO=1 in the shell to load fictional school records into an empty database.

# Vercel / MongoDB Atlas (set these in Vercel project environment variables).
# Never commit a real connection string or setup key.
MONGODB_URI=
MONGODB_DB=school_erp
ERP_ORIGIN=https://your-project.vercel.app
ERP_SECURE_COOKIE=1
